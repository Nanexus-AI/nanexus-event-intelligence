# v0.1.0 provides no built-in authentication or authorization.
# Use only on a trusted local network; never expose ports 5173 or 8000 publicly.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://nanexus:nanexus@postgres:5432/nanexus
REDIS_URL=redis://redis:6379/0
PIPELINE_STREAM=nanexus:canonical-events
PIPELINE_GROUP=nanexus:canonical-workers
ALERT_SHADOW_GROUP=nanexus:shadow-decisions
NOTIFICATION_GROUP=nanexus:community-notifications
NOTIFICATION_WEBHOOK_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TRUSTED_INTERNAL=false
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=5
PIPELINE_DLQ_STREAM=nanexus:canonical-events:dlq
PIPELINE_BATCH_SIZE=50
PIPELINE_BLOCK_MS=1000
PIPELINE_PENDING_IDLE_MS=30000
PIPELINE_MAX_DELIVERY_ATTEMPTS=5
PIPELINE_MAX_INFLIGHT_MESSAGES=100000
PIPELINE_ERROR_BACKOFF_SECONDS=2.0
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:8000


# Frigate fixture recorder (development only; keep real passwords in the untracked .env file)
FRIGATE_MQTT_HOST=
FRIGATE_MQTT_PORT=1883
FRIGATE_MQTT_USERNAME=
FRIGATE_MQTT_PASSWORD=
FRIGATE_MQTT_TOPIC_PREFIX=frigate
FRIGATE_MQTT_TLS=false
FRIGATE_MQTT_CLIENT_ID=nanexus-frigate-live-ingest
FRIGATE_MQTT_INGEST_TIMEOUT_SECONDS=30
FRIGATE_SOURCE_NAME=frigate-primary
FRIGATE_SOURCE_VERSION=0.17.1-416a9b7

# Frigate HTTP API (port 8971 is recommended; choose exactly one of the four authentication modes)
FRIGATE_HTTP_BASE_URL=
FRIGATE_HTTP_BEARER_TOKEN=
FRIGATE_HTTP_USERNAME=
FRIGATE_HTTP_PASSWORD=
FRIGATE_HTTP_PROXY_SECRET=
FRIGATE_HTTP_TRUSTED_INTERNAL=false
FRIGATE_HTTP_CA_BUNDLE=
